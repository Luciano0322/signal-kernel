{
  "name": "@signal-kernel/react",
  "version": "0.5.4",
  "description": "Thin React adapter for subscribing to signal-kernel graph values and async resources without making React own the graph.",
  "type": "module",
  "author": "Luciano Lee",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "AI_USAGE.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Luciano0322/signal-kernel.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/Luciano0322/signal-kernel/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/Luciano0322/signal-kernel/issues"
  },
  "keywords": [
    "signal-kernel",
    "signals",
    "reactivity",
    "react",
    "react-hooks",
    "reactive-graph",
    "fine-grained-reactivity",
    "external-store",
    "framework-adapter",
    "async-resource",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --tsconfig tsconfig.dts.json",
    "lint": "pnpm exec eslint src --ext .ts",
    "typecheck": "pnpm exec tsc --noEmit",
    "test": "pnpm exec vitest run"
  },
  "dependencies": {
    "@signal-kernel/core": "workspace:*",
    "@signal-kernel/async-runtime": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
