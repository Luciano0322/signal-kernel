{
  "name": "@signal-kernel/snapshot",
  "version": "0.1.0",
  "description": "Framework-neutral toolkit for capturing, encoding, diffing, and restoring explicit reactive graph state.",
  "type": "module",
  "author": "Luciano Lee",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "AI_USAGE.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Luciano0322/signal-kernel.git",
    "directory": "packages/snapshot"
  },
  "homepage": "https://github.com/Luciano0322/signal-kernel/tree/main/packages/snapshot#readme",
  "bugs": {
    "url": "https://github.com/Luciano0322/signal-kernel/issues"
  },
  "keywords": [
    "signal-kernel",
    "signals",
    "reactivity",
    "reactive-graph",
    "graph-snapshot",
    "state-transfer",
    "serialization",
    "json",
    "restore",
    "diff",
    "redaction",
    "framework-agnostic",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --tsconfig tsconfig.dts.json",
    "lint": "pnpm exec eslint src --ext .ts",
    "typecheck": "pnpm exec tsc --noEmit",
    "test": "pnpm exec vitest run"
  },
  "dependencies": {}
}
