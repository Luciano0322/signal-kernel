{
  "name": "@signal-kernel/async-runtime",
  "version": "0.4.2",
  "description": "Framework-neutral async reactive runtime for cancellable resources, stale-result protection, invalidation, and push streams.",
  "type": "module",
  "author": "Luciano Lee",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "AI_USAGE.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Luciano0322/signal-kernel.git",
    "directory": "packages/async-runtime"
  },
  "homepage": "https://github.com/Luciano0322/signal-kernel/tree/main/packages/async-runtime#readme",
  "bugs": {
    "url": "https://github.com/Luciano0322/signal-kernel/issues"
  },
  "keywords": [
    "signal-kernel",
    "signals",
    "reactivity",
    "async-reactivity",
    "async-resource",
    "cancellation",
    "abort-signal",
    "stale-result-protection",
    "last-write-wins",
    "stream-resource",
    "push-stream",
    "framework-agnostic",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --tsconfig tsconfig.dts.json",
    "lint": "pnpm exec eslint src --ext .ts",
    "typecheck": "pnpm exec tsc --noEmit",
    "pretest": "pnpm -F @signal-kernel/core build",
    "test": "pnpm exec vitest run"
  },
  "dependencies": {
    "@signal-kernel/core": "workspace:*"
  }
}
