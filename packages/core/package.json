{
  "name": "@signal-kernel/core",
  "version": "0.1.5",
  "description": "Framework-agnostic fine-grained reactive graph runtime with lazy computed values, deterministic effects, and batching.",
  "type": "module",
  "author": "Luciano Lee",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Luciano0322/signal-kernel.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Luciano0322/signal-kernel/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Luciano0322/signal-kernel/issues"
  },
  "keywords": [
    "signal-kernel",
    "signals",
    "reactivity",
    "reactive-graph",
    "fine-grained-reactivity",
    "lazy-computed",
    "dependency-tracking",
    "deterministic-scheduler",
    "batching",
    "framework-agnostic",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --tsconfig tsconfig.dts.json",
    "bench": "vitest bench --run bench/scheduler.bench.ts",
    "lint": "pnpm exec eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
