flowchart TD
  A["signal.set()"] --> B["Propagate computed invalidation"]

  B --> C["Schedule affected effects (deduped)"]

  subgraph Flush["Deterministic effect flush"]
    C --> D["Execute next effect (by priority)"]
    D --> E{"Reads a stale computed?"}
    E -- Yes --> F["Recompute lazily and cache"]
    E -- No --> G["Continue effect"]
    F --> G
  end

  G --> H{"New work generated?"}

  H -- Yes --> C
  H -- No --> I["Flush complete"]
